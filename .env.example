# Postgres connection (Vercel Postgres / Neon). Use the pooled URL for DATABASE_URL
# and the direct (non-pooled) URL for DIRECT_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rbsm"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/rbsm"

# Long random string used to sign login sessions. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me"

# Comma-separated emails that get organiser (admin) access.
ADMIN_EMAILS="itd@indiasmeforum.org"

# Public URL of the site, used in email links.
APP_URL="http://localhost:3000"

# Email sending via Resend (https://resend.com). If RESEND_API_KEY is empty,
# emails (including login codes) are printed to the server log instead.
RESEND_API_KEY=""
EMAIL_FROM="RBSM Connect <rbsm@indiasmeforum.org>"
